# Local development works without external accounts. Never commit real credentials.
OT_APP_ENV=development
OT_DATABASE_PATH=.data/ot-center.sqlite
# Vercel requires a persistent remote libSQL database; no filesystem fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NUXT_PUBLIC_SITE_URL=https://otcenter.kz
OT_NOINDEX=false
# Auth transactional mail only. Disabled until transport is configured.
SMTP_URL=
MAIL_FROM=
OT_EMAIL_DELIVERY_ENABLED=0
# Existing amoCRM contract and old names both work.
AMO_BASE_URL=
AMO_ACCESS_TOKEN=
AMO_SUBDOMAIN=
AMO_LONG_TOKEN=
AMO_LEAD_CITY_FIELD_ID=
AMO_LEAD_COMMENT_FIELD_ID=
OT_CRM_DELIVERY_ENABLED=0
# Never expose these in NUXT_PUBLIC_*.
CRON_SECRET=
# Operator alerts are separate from auth mail and remain disabled until configured.
OT_OPERATIONAL_ALERTS_ENABLED=0
OT_ALERT_EMAIL=
OT_ALERT_OUTBOX_MINUTES=60
OT_ALERT_LEAD_MINUTES=120
OT_ALERT_CREDENTIAL_MINUTES=60
OT_ALERT_PAYMENT_MINUTES=1440
# First-party analytics requires a configured retention policy; browser events also require separate opt-in.
# Set 1..90 days only after configuring the daily cleanup tick. No external analytics service is used.
OT_ANALYTICS_ENABLED=0
OT_ANALYTICS_RETENTION_DAYS=
# Disabled by default; only isolated local/test or staging supports sandbox.
OT_PAYMENT_PROVIDER=disabled
OT_PAYMENT_TERMS_APPROVED=0
OT_PAYMENT_TERMS_VERSION=
OT_SANDBOX_MERCHANT=
OT_SANDBOX_WEBHOOK_SECRET=
# Corporate bank-transfer invoices require the owner's actual issuer details.
# See docs/CORE_INVOICES.md for the JSON schema. No payment gateway is activated.
OT_INVOICE_ENABLED=0
OT_INVOICE_ISSUER_JSON=
# HTTPS media domains approved by the content owner, comma separated.
OT_CONTENT_HOSTS=
# Encryption password for CLI backups; use a secret store, not this file.
OT_BACKUP_PASSWORD=
